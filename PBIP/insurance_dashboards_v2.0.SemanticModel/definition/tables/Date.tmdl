	hierarchy year-quarter-month-day
		lineageTag: 2d49829a-671d-435a-bb7b-4426f572e122

		level Year
			lineageTag: c41beffa-dcdc-4459-a9cf-546e8a3f207b
			column: year

		level Quarter
			lineageTag: a0d18648-198c-4d24-aa77-b1e1a51bd3dd
			column: quarter

		level Month
			lineageTag: fce19b61-e156-4ca7-9988-0773a3bbfa4e
			column: month_name_short

		level day
			lineageTag: 76d735c1-ba62-4886-b239-08463e1786c6
			column: day

	partition Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2022, 1, 1 ), DATE ( 2025, 12, 31 ) ),
				    // Numeric surrogate key
				    "date_as_integer",
				        YEAR ( [Date] ) * 10000 + MONTH ( [Date] ) * 100 + DAY ( [Date] ),
				    // Year
				    "year", YEAR ( [Date] ),
				    // Quarter
				    "quarter", "Q" & QUARTER ( [Date] ),
				    "year_quarter",
				        YEAR ( [Date] ) & "Q" & QUARTER ( [Date] ),
				    // Month
				    "month_number", MONTH ( [Date] ),
				    "month_name_short", FORMAT ( [Date], "mmm" ),
				    "month_name_long", FORMAT ( [Date], "mmmm" ),
				    "year_month_number",
				        YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "year_month_number_text", FORMAT ( [Date], "YYYY/MM" ),
				    "year_month_name_short", FORMAT ( [Date], "YYYY/mmm" ),
				    // Week (starts with Monday)
				    "week_number", WEEKNUM ( [Date], 2 ),
				    "year_week_number",
				        YEAR ( [Date] ) * 100 + WEEKNUM ( [Date], 2 ),
				    "day_of_week_number", WEEKDAY ( [Date], 2 ),
				    "day_of_week_name_long", FORMAT ( [Date], "dddd" ),
				    "day_of_week_name_short", FORMAT ( [Date], "ddd" ),
				    // Day
				    "day", DAY ( [Date] )
				)

	annotation PBI_Id = 95a843fc84634a598ae8e4f71cb94cb9

