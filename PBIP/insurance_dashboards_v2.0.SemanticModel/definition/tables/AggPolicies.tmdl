	partition AggPolicies = m
		mode: import
		queryGroup: 'Aggregation tables'
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database(ServerName, DataBaseName), "SELECT#(lf)    product_id,#(lf)    DATE_TRUNC('month',start_date) AS start_month, #(lf)    DATE_TRUNC('month',end_date) AS end_month,#(lf)    SUM(premium_amount) AS total_premium,#(lf)    SUM(coverage_amount) AS total_coverage#(lf)FROM FactPolicies#(lf)GROUP BY #(lf)    product_id,#(lf)    DATE_TRUNC('month',start_date), #(lf)    DATE_TRUNC('month',end_date)", null, [EnableFolding=true])
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

