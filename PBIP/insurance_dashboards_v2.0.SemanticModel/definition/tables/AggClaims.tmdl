	partition AggClaims = m
		mode: import
		queryGroup: 'Aggregation tables'
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database(ServerName, DataBaseName), "SELECT#(lf)    policy_id,#(lf)    claim_status_id,#(lf)    DATE_TRUNC('month',occurred_date) AS occurred_month, #(lf)    DATE_TRUNC('month',reported_date) AS reported_month,#(lf)    DATE_TRUNC('month',settled_date) AS settled_month,#(lf)    DATE_TRUNC('month',paid_date) AS paid_month,#(lf)    SUM(claim_amount) AS total_claim_amount,#(lf)    SUM(payout_amount) AS total_payout_amount#(lf)FROM FactClaims#(lf)GROUP BY #(lf)    policy_id,#(lf)    claim_status_id,#(lf)    DATE_TRUNC('month',occurred_date), #(lf)    DATE_TRUNC('month',reported_date),#(lf)    DATE_TRUNC('month',settled_date),#(lf)    DATE_TRUNC('month',paid_date)", null, [EnableFolding=true])
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

