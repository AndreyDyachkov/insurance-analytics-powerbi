		lineageTag: 539facaf-a94e-4012-87ee-bc8cc5d0a5ce

	measure 'GPW YTD Achivement %' =
			
			DIVIDE([GPW YTD],[Budget GPW YTD],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Premium Measures
		lineageTag: 8e6f763a-9a34-4218-ad25-e71c1457fdb7

	measure 'Customers Count' =
			
