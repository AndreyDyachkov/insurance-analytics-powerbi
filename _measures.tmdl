			)
		displayFolder: Policy Measures
		lineageTag: e10bd89c-01ac-4338-bf15-bf578b5d9f6d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'GPW YTD YoY%' =
			
