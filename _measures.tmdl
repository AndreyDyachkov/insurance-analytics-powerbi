	measure Exposure = ```
			
			    -- Get reporting period boundaries
			    VAR ReportStart = FIRSTDATE('Date'[Date])  
			    VAR ReportEnd = LASTDATE('Date'[Date])
			    VAR RelevantPolicies = 
			        CALCULATETABLE(
			            FactPolicies,
			            FactPolicies[start_date] <= ReportEnd,
			            FactPolicies[end_date] >= ReportStart
			        )
			    RETURN
			
			    -- Calculate exposure for each relevant policy 
			    SUMX(
			        RelevantPolicies,
			        -- Policy-specific variables (calculated per row)
			        VAR PolicyStart = FactPolicies[start_date]
			        VAR PolicyEnd = FactPolicies[end_date]
			        VAR PolicyDays = DATEDIFF(PolicyStart, PolicyEnd, DAY) + 1
			        
			        -- Calculate overlap between policy and reporting periods
			        VAR EarnedStart = MAX(PolicyStart, ReportStart)
			        VAR EarnedEnd = MIN(PolicyEnd, ReportEnd)
			        VAR EarnedDays = DATEDIFF(EarnedStart, EarnedEnd, DAY) + 1 
			                
			        -- Return earned premium for this policy
			        RETURN DIVIDE(EarnedDays, PolicyDays, 0)
			    )
			```
		displayFolder: Policy Measures
		lineageTag: 0f016c4f-3d27-4f75-b8ee-f77295d91363

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Frequency =
			
