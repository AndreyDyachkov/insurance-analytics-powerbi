		formatString: #,0.00
		displayFolder: Premium Measures
		lineageTag: d023b3e0-ee11-42d0-b0be-7d73160145a5

	measure 'GPW YoY%' =
			
			DIVIDE([GPW],[GPW PY],0)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: Premium Measures
		lineageTag: 5c6e7b55-92b9-41ec-b417-ed070dccf71e

	measure 'GPW YTD PY' =
			
			CALCULATE(
			    [GPW YTD],
			    DATEADD(PolicyDate[Date], -1, YEAR)
			)
		formatString: #,0.00
		displayFolder: Premium Measures
		lineageTag: 695271d3-2e9b-4765-b926-da38ad3541bc

	measure 'Avg Coverage Amount per Policy' =
			
			AVERAGE(FactPolicies[coverage_amount])
		formatString: #,0.00
		displayFolder: Policy Measures
		lineageTag: 744dca81-3c79-4dce-803e-6ca3ac0102df

	measure 'RBNS (Reported But Not Settled)' =
			
			-- Sum of pending claims (estimated future payouts)
			CALCULATE(
			    SUM(FactClaims[claim_amount]),
			    RELATEDTABLE(DimClaimStatus),
			    DimClaimStatus[status_name] = "Pending"
			)
		formatString: #,0.00
		displayFolder: Claim & Loss Measures
		lineageTag: 12da971e-f99e-43dd-b911-c4e2314a605c

	measure 'Paid Losses' =
			
			-- Sum of approved claims (actual payouts made)
			CALCULATE(
			    SUM(FactClaims[payout_amount]),
			    RELATEDTABLE(DimClaimStatus),
			    DimClaimStatus[status_name] = "Approved"
			)
		formatString: #,0.00
		displayFolder: Claim & Loss Measures
		lineageTag: 3409e4b4-b0e7-445e-a65d-38e0c4aaa551

	measure Losses =
			[Paid Losses] + [RBNS (Reported But Not Settled)]
			-- not include IBNR for simplicity
		formatString: #,0.00
		displayFolder: Claim & Loss Measures
		lineageTag: 45700c48-1b8d-483f-b3c8-21a79234f897

	measure 'GPE (Gross Premium Earned)' = ```
			
			    -- Get reporting period boundaries
			    VAR ReportStart = FIRSTDATE('Date'[Date])  
			    VAR ReportEnd = LASTDATE('Date'[Date])
			    VAR RelevantPolicies = 
			        CALCULATETABLE(
			            FactPolicies,
			            FactPolicies[start_date] <= ReportEnd,
			            FactPolicies[end_date] >= ReportStart
			        )
			    RETURN
			
			    -- Calculate earned premium for each relevant policy 
			    SUMX(
			        RelevantPolicies,
			        -- Policy-specific variables (calculated per row)
			        VAR PolicyStart = FactPolicies[start_date]
			        VAR PolicyEnd = FactPolicies[end_date]
			        VAR PremiumAmount = FactPolicies[premium_amount]
			        VAR PolicyDays = DATEDIFF(PolicyStart, PolicyEnd, DAY) + 1
			        
			        -- Calculate overlap between policy and reporting periods
			        VAR EarnedStart = MAX(PolicyStart, ReportStart)
			        VAR EarnedEnd = MIN(PolicyEnd, ReportEnd)
			        VAR EarnedDays = DATEDIFF(EarnedStart, EarnedEnd, DAY) + 1 
			                
			        -- Return earned premium for this policy
			        RETURN DIVIDE(PremiumAmount * EarnedDays, PolicyDays, 0)
			    )
			```
		formatString: #,0.00
		displayFolder: Premium Measures
		lineageTag: c1bd6e55-3a88-4f53-a419-cdd1fc6f9614

	measure 'LR (Loss Ratio)' =
			
			DIVIDE([Losses],[GPE (Gross Premium Earned)],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Profitability Measures
		lineageTag: 498118fa-7168-4166-9cf8-8eccc6c05c78

	measure 'CR (Combined Ratio)' = [LR (Loss Ratio)]+[CommissionRate Value]+[ExpenseRatio Value]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Profitability Measures
		lineageTag: b0b2eaae-85e7-4d75-b268-c13e7e4d61a5

	measure 'Active Policies Coverage Amount' =
			
			CALCULATE(
			    [Coverage Amount],
