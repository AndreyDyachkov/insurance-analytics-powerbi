		formatString: #,0.00
		displayFolder: Premium Measures
		lineageTag: 734c69ee-1c65-4911-8c22-62f37ca9c5e9

	measure 'Customer Lifetime Value (LTV)' =
			
			VAR GPE = [GPE (Gross Premium Earned)]
			RETURN
			GPE
			- GPE * [CommissionRate Value]
			 - GPE * [ExpenseRatio Value]
			 - [Losses]
		displayFolder: Customer Measures
		lineageTag: 350c0067-2d83-49a6-8be3-d71271dce90e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg LOB per Customer' =
			
			AVERAGEX(
			    VALUES(FactPolicies[customer_id]),
			    CALCULATE(
			        DISTINCTCOUNT(DimProduct[policy_type_name])
			    )
			)
		formatString: #,0.00
		displayFolder: Customer Measures
		lineageTag: c003ce4d-27af-444b-ac4e-e37e1c09ebdf

	measure 'Avg Products Count per Customer' =
			
			AVERAGEX (
			    VALUES ( FactPolicies[customer_id] ),
			    CALCULATE (
			        DISTINCTCOUNT ( FactPolicies[product_id] )
			    )
			)
		displayFolder: Customer Measures
		lineageTag: 7fc56b1a-c066-49aa-b5c4-c56162454b2f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg GPW per Customer' =
			
